PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=spleenet_session
SESSION_TTL_SECONDS=86400
SESSION_REDIS_PREFIX=session:
COOKIE_SECURE=false
# COOKIE_DOMAIN=localhost
# Optional until media upload is implemented
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@spleenet.com
EMAIL_VERIFY_TTL_SECONDS=86400
EMAIL_VERIFY_REDIS_PREFIX=email_verify:
NOTIFICATION_QUEUE_NAME=notifications
ADMIN_NOTIFICATION_EMAIL=true
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxx
# Payment provider: paystack (default) or moolre (Ghana mobile money)
PAYMENT_PROVIDER=paystack
MOOLRE_BASE_URL=https://api.moolre.com
MOOLRE_API_USER=
# Private API Key from app.moolre.com (not the wallet secret)
MOOLRE_API_KEY=
MOOLRE_API_PUBKEY=
# Wallet secret from Moolre wallet details (used for webhook verification)
MOOLRE_WEBHOOK_SECRET=
MOOLRE_WEBHOOK_URL=
MOOLRE_ACCOUNT_NUMBER=
# FCM_PROJECT_ID=your-project-id
# FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# YouTube Data API v3 — used for auto-verifying creator YouTube channels and submission video stats
# Get an API key from https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" for your GCP project
# YOUTUBE_API_KEY=AIzaSy...

# Instagram & TikTok verification uses public web endpoints and does not require API keys.
# Creator handles are verified by fetching public profile data directly.
